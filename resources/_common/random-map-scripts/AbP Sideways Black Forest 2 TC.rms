<CONNECTION_GENERATION>

/* AbP: 16 lands instead of 8. Without this every pair of lands gets its own corridor and the forest is shredded; with it later paths reuse the corridors already cut. */
accumulate_connections

create_connect_all_players_land
{
	replace_terrain FOREST	GRASS	
	terrain_cost    GRASS		2
	terrain_cost    GRASS3		2
	terrain_cost    FOREST	6
	terrain_cost	WATER		9
	terrain_cost	WATER		99
	terrain_cost    PINE_FOREST 	99
	terrain_size    FOREST  	9       0
}

create_connect_teams_lands
{
	replace_terrain	FOREST	GRASS
	terrain_cost	ROAD		0
	terrain_cost	WATER		9
	terrain_cost	WATER		99
	terrain_cost    PINE_FOREST 	99
	terrain_cost    FOREST	7
	terrain_size	FOREST	3	0
}

create_connect_teams_lands
{
	replace_terrain	GRASS		ROAD
	replace_terrain	GRASS3		ROAD
	replace_terrain	FOREST   	ROAD
	terrain_cost	ROAD		0
	terrain_cost	WATER		9
	terrain_cost	WATER		99
	terrain_cost    PINE_FOREST 	99
	terrain_cost    FOREST	7
	terrain_size	GRASS		1	0
	terrain_size	GRASS3		1	0
	terrain_size	FOREST	1	0
}