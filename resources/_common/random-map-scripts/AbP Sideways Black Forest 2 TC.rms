/* AbP Sideways Black Forest 2 TC: MBA Sideways Black Forest + a second town center for every player. Burrito recipe: fixed team-side spawns with two lands per player (direct_placement + assign_to AT_TEAM), so the shared include gives each TC its own villagers, scout and starting resources. No-collision trade carts. */

/* PH SEASONS */

start_random
percent_chance 50 #define PH_SPRING
percent_chance 50 #define PH_AUTUMN
end_random

#include_drs F_seasons.inc

<PLAYER_SETUP>

/* no-collision trade carts (Tres Leches 2 proven config) */
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_1 0
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_LINE_OF_SIGHT 4
/* effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_2 0 */ /* kept off - both radii zeroed = carts walk on water */

	base_terrain GRASS3
  direct_placement /* AbP: fixed team-side spawns, see LAND_GENERATION */
  ai_info_map_type BLACK_FOREST 0 0 0


<LAND_GENERATION>

base_terrain GRASS3
enable_waves 1 

/* AbP: fixed team-side spawns, the recipe proven in AbP Burrito Brawl 4v4. direct_placement + assign_to AT_TEAM:
   team 1 fills the left side top-to-bottom in lobby order, team 2 the right. Each player gets an inner home
   nearer the middle forest (listed first with flags 2 = "do not remember", so the paired land resolves to the
   same player) and an outer home (flags 0 records the player, the next pair moves on). 33x33 clearings each.
   The shared include then places a town center, 3 villagers, a scout and the full starting kit on both lands.
   REQUIRES two real teams of 2+ players (a 1-player team does not count): no 1v1, no FFA. Large or bigger.
   Two create_player_lands with team grouping is NOT usable: DE piles every second land on one spot. */
/* team 1 - left: inner home, then outer home, per player */
create_land { land_position 23 15 zone 1 assign_to AT_TEAM 1 -1 2 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 9 15 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 23 38 zone 1 assign_to AT_TEAM 1 -1 2 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 9 38 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 23 61 zone 1 assign_to AT_TEAM 1 -1 2 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 9 61 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 23 84 zone 1 assign_to AT_TEAM 1 -1 2 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 9 84 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
/* team 2 - right: inner home, then outer home, per player */
create_land { land_position 77 15 zone 2 assign_to AT_TEAM 2 -1 2 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 91 15 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 77 38 zone 2 assign_to AT_TEAM 2 -1 2 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 91 38 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 77 61 zone 2 assign_to AT_TEAM 2 -1 2 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 91 61 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 77 84 zone 2 assign_to AT_TEAM 2 -1 2 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }
create_land { land_position 91 84 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type GRASS base_size 16 land_percent 0 base_elevation 2 other_zone_avoidance_distance 1 }

/* ----------------------------------Middle forest and lake----------------------------------- */
create_land 
{
  terrain_type PINE_FOREST
  land_position 50 50
	if TINY_MAP
		base_size 25
		base_size 25
	elseif SMALL_MAP
		base_size 30
	elseif MEDIUM_MAP
		base_size 35
	elseif LARGE_MAP
		base_size 40
	elseif HUGE_MAP
		base_size 45
	elseif GIGANTIC_MAP
		base_size 50
	elseif LUDIKRIS_MAP
		base_size 50
	endif
  number_of_tiles 0
  zone 18
}

<TERRAIN_GENERATION>



create_terrain GRASS
{
	base_terrain                   GRASS3
	spacing_to_other_terrain_types 5
	land_percent                   22
	number_of_clumps               7
	set_avoid_player_start_areas     
	set_scale_by_groups
	clumping_factor                8
	height_limits 0 4                      
}

create_terrain FOREST
{
	base_terrain                   GRASS3
	spacing_to_other_terrain_types 0
	land_percent                   100
	number_of_clumps               50
	set_avoid_player_start_areas     
	set_scale_by_groups
	clumping_factor                1
	height_limits 0 4                      
}

create_terrain WATER
{
	base_terrain                   GRASS
	spacing_to_other_terrain_types 1
	number_of_tiles			800
	number_of_clumps               6
	set_avoid_player_start_areas     
	set_flat_terrain_only
	clumping_factor                8
	height_limits 0 1
}


create_terrain GRASS3
{
	base_terrain                   GRASS
	spacing_to_other_terrain_types 3
	land_percent                   20
	number_of_clumps               50
	set_avoid_player_start_areas     
	set_scale_by_groups
	clumping_factor                4
	height_limits 0 4                      
}

create_terrain DLC_BEACH2
{
	base_terrain GRASS3
	spacing_to_other_terrain_types 0
	land_percent 			2
	number_of_clumps              15
	clumping_factor                5
	border_fuzziness                3
	terrain_mask 1
	height_limits 0 4
}

   create_terrain DLC_BEACH2
{
	base_terrain GRASS
	spacing_to_other_terrain_types 0
	land_percent 			6
	number_of_clumps              50
	clumping_factor                5
	border_fuzziness               1
	terrain_mask 1
	height_limits 0 4
}


