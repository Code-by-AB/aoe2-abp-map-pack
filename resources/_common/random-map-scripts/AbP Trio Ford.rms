    second_object PLANT_WEEDS
    number_of_objects 2
    number_of_groups 12
    set_loose_grouping
    group_placement_radius 2
    set_gaia_object_only
    set_scaling_to_map_size
    temp_min_distance_group_placement 10
    terrain_to_place_on DLC_MANGROVESHALLOW
    ignore_terrain_restrictions
}

