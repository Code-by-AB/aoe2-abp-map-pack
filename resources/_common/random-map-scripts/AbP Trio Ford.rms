<TERRAIN_GENERATION>

create_terrain FOREST
{
	base_terrain                   GRASS3
	spacing_to_other_terrain_types 0
	land_percent                   100
	number_of_clumps               70
	set_avoid_player_start_areas     30
	set_scale_by_groups
	clumping_factor                1
	height_limits 0 4                      
}

#const WELL 1567
#const GOODS  916
#const VULTURE 1305
#const ROCK 623

<OBJECTS_GENERATION>

#define GNR_NORMALTC
#define GNR_STARTVILLS
#define GNR_CLASSICSCOUT

#define GNR_RELICMODERN_MEDIUM

#define GNR_RESCLOSE

#define GNR_REGICIDECLASSIC

#define GNR_HUNT3OR4CLASSIC

#define GNR_FARGMODERN_GIVE
#define GNR_FARSMODERN_GIVE

#define GNR_FARG_CLASSIC
#define GNR_FARS_CLASSIC

#define GNR_ADDITIONALPRED


#include_drs GeneratingObjects.inc


create_object OAKTREE
{ 
	number_of_objects				40
	number_of_groups				5
	group_placement_radius			3
	set_tight_grouping 
	set_gaia_object_only 
	set_place_for_every_player
	min_distance_to_players			15
	max_distance_to_players			19
	min_distance_group_placement	4
} 

create_object RELIC
{
   number_of_objects            1
   min_distance_to_players     20
	max_distance_to_players			25
	set_gaia_object_only
	set_place_for_every_player
}

create_object RELIC
{
   number_of_objects            1
   number_of_groups 5
   set_gaia_object_only
   set_scaling_to_map_size
   terrain_to_place_on DIRT
}

create_object RELIC {
    number_of_objects 21
    set_gaia_object_only
    min_distance_group_placement 2
    terrain_to_place_on DIRT3
    ignore_terrain_restrictions
}

