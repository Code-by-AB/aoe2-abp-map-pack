/* ------------------------------------------------ guaranteed pond per player (Alpine Lakes address labels) */

#const ABP_LBL_1 23
#const ABP_LBL_2 25
#const ABP_LBL_3 27
#const ABP_LBL_4 29
#const ABP_LBL_5 31
#const ABP_LBL_6 33
#const ABP_LBL_7 38
#const ABP_LBL_8 39

<TERRAIN_GENERATION>

/* each label floods exactly one base (single contiguous clump) */

create_terrain ABP_LBL_1 { base_terrain GRASS land_percent 100 number_of_clumps 1 }
create_terrain ABP_LBL_2 { base_terrain GRASS land_percent 100 number_of_clumps 1 }
create_terrain ABP_LBL_3 { base_terrain GRASS land_percent 100 number_of_clumps 1 }
create_terrain ABP_LBL_4 { base_terrain GRASS land_percent 100 number_of_clumps 1 }
create_terrain ABP_LBL_5 { base_terrain GRASS land_percent 100 number_of_clumps 1 }
create_terrain ABP_LBL_6 { base_terrain GRASS land_percent 100 number_of_clumps 1 }
create_terrain ABP_LBL_7 { base_terrain GRASS land_percent 100 number_of_clumps 1 }
create_terrain ABP_LBL_8 { base_terrain GRASS land_percent 100 number_of_clumps 1 }

/* one dockable walkable mangrove pond per labelled base */

create_terrain DLC_MANGROVESHALLOW { base_terrain ABP_LBL_1 number_of_tiles rnd(28,40) number_of_clumps 1 clumping_factor 15 set_avoid_player_start_areas 8 }
create_terrain DLC_MANGROVESHALLOW { base_terrain ABP_LBL_2 number_of_tiles rnd(28,40) number_of_clumps 1 clumping_factor 15 set_avoid_player_start_areas 8 }
create_terrain DLC_MANGROVESHALLOW { base_terrain ABP_LBL_3 number_of_tiles rnd(28,40) number_of_clumps 1 clumping_factor 15 set_avoid_player_start_areas 8 }
create_terrain DLC_MANGROVESHALLOW { base_terrain ABP_LBL_4 number_of_tiles rnd(28,40) number_of_clumps 1 clumping_factor 15 set_avoid_player_start_areas 8 }
create_terrain DLC_MANGROVESHALLOW { base_terrain ABP_LBL_5 number_of_tiles rnd(28,40) number_of_clumps 1 clumping_factor 15 set_avoid_player_start_areas 8 }
create_terrain DLC_MANGROVESHALLOW { base_terrain ABP_LBL_6 number_of_tiles rnd(28,40) number_of_clumps 1 clumping_factor 15 set_avoid_player_start_areas 8 }
create_terrain DLC_MANGROVESHALLOW { base_terrain ABP_LBL_7 number_of_tiles rnd(28,40) number_of_clumps 1 clumping_factor 15 set_avoid_player_start_areas 8 }
create_terrain DLC_MANGROVESHALLOW { base_terrain ABP_LBL_8 number_of_tiles rnd(28,40) number_of_clumps 1 clumping_factor 15 set_avoid_player_start_areas 8 }

/* repaint labels back to grass */

create_terrain GRASS { base_terrain ABP_LBL_1 land_percent 100 number_of_clumps 512 }
create_terrain GRASS { base_terrain ABP_LBL_2 land_percent 100 number_of_clumps 512 }
create_terrain GRASS { base_terrain ABP_LBL_3 land_percent 100 number_of_clumps 512 }
create_terrain GRASS { base_terrain ABP_LBL_4 land_percent 100 number_of_clumps 512 }
create_terrain GRASS { base_terrain ABP_LBL_5 land_percent 100 number_of_clumps 512 }
create_terrain GRASS { base_terrain ABP_LBL_6 land_percent 100 number_of_clumps 512 }
create_terrain GRASS { base_terrain ABP_LBL_7 land_percent 100 number_of_clumps 512 }
create_terrain GRASS { base_terrain ABP_LBL_8 land_percent 100 number_of_clumps 512 }

/* ------------------------------------------------ field woodlines (moderate - trade friendly) */

create_terrain FOREST
{
	base_terrain GRASS3
	land_percent 16
	number_of_clumps 16
	spacing_to_other_terrain_types 3
	clumping_factor 12
	set_avoid_player_start_areas 22
	set_scale_by_groups
}

create_terrain GRASS2
{
	base_terrain GRASS3
	land_percent 6
	number_of_clumps 14
	spacing_to_other_terrain_types 1
	set_scale_by_size
}

