/* ************ AbP Onion ************ */
/* Peel it layer by layer: forest / stone wall / forest / gold wall / relic core / marlin pool */
/* Every technique in this map is documented in the AbP Map Pack README */

<PLAYER_SETUP>
random_placement
grouped_by_team

/* no-collision trade carts (Tres Leches 2 proven config) */
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_1 0
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_LINE_OF_SIGHT 4
/* effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_2 0 */ /* kept off - both radii zeroed = carts walk on water */

<LAND_GENERATION>

base_terrain GRASS3

/* ------------------------------------------------ player lands */

create_player_lands
{
	terrain_type GRASS
	land_percent 40
	base_size 11
	border_fuzziness 15
	other_zone_avoidance_distance 22
	circle_radius 37
}

/* ------------------------------------------------ the onion (scaled rings, painted big to small) */

create_land
{
	terrain_type FOREST
	land_position 50 50
	if TINY_MAP
		base_size 20
	elseif SMALL_MAP
		base_size 23
	elseif MEDIUM_MAP
		base_size 26
	elseif LARGE_MAP
		base_size 28
	elseif HUGE_MAP
		base_size 30
	elseif GIGANTIC_MAP
		base_size 33
	elseif LUDIKRIS_MAP
		base_size 33
	endif
	number_of_tiles 0
	zone 30
	other_zone_avoidance_distance 10
}

create_land
{
	terrain_type DIRT2
	land_position 50 50
	if TINY_MAP
		base_size 17
	elseif SMALL_MAP
		base_size 19
	elseif MEDIUM_MAP
		base_size 22
	elseif LARGE_MAP
		base_size 24
	elseif HUGE_MAP
		base_size 26
	elseif GIGANTIC_MAP
		base_size 28
	elseif LUDIKRIS_MAP
