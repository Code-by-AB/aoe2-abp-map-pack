	elseif MEDIUM_MAP
		base_size 14
	elseif LARGE_MAP
		base_size 16
	elseif HUGE_MAP
		base_size 17
	elseif GIGANTIC_MAP
		base_size 19
	elseif LUDIKRIS_MAP
		base_size 19
	endif
	number_of_tiles 0
	zone 30
}

create_land { terrain_type DLC_MANGROVESHALLOW land_position 50 50 base_size 4 number_of_tiles 0 zone 30 }

