
/* PH SEASONS */

start_random
percent_chance 50 #define PH_SPRING
percent_chance 50 #define PH_AUTUMN
end_random

#include_drs F_seasons.inc

<PLAYER_SETUP>

/* no-collision trade carts (Tres Leches 2 proven config) */
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_1 0
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_LINE_OF_SIGHT 4
/* effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_2 0 */ /* kept off - both radii zeroed = carts walk on water */

	base_terrain GRASS3
  grouped_by_team
  ai_info_map_type BLACK_FOREST 0 0 0


<LAND_GENERATION>

base_terrain GRASS3
enable_waves 1 

create_player_lands 
{ 
	terrain_type                     GRASS 
	base_size                        20
	land_percent			 3
	clumping_factor                  1
	border_fuzziness                 1 
	set_zone_by_team
    base_elevation 2
	other_zone_avoidance_distance    20
	circle_placement
	circle_radius 42
}

/* ----------------------------------Middle forest and lake----------------------------------- */
create_land 
{
  terrain_type PINE_FOREST
  land_position 50 50
	if TINY_MAP
		base_size 25
		base_size 25
	elseif SMALL_MAP
		base_size 30
	elseif MEDIUM_MAP
		base_size 35
	elseif LARGE_MAP
		base_size 40
	elseif HUGE_MAP
		base_size 45
	elseif GIGANTIC_MAP
		base_size 50
	elseif LUDIKRIS_MAP
		base_size 50
	endif
  number_of_tiles 0
  zone 18
}

<TERRAIN_GENERATION>



create_terrain GRASS
{
	base_terrain                   GRASS3
	spacing_to_other_terrain_types 5
	land_percent                   22
	number_of_clumps               7
	set_avoid_player_start_areas     
	set_scale_by_groups
	clumping_factor                8
	height_limits 0 4                      
}

