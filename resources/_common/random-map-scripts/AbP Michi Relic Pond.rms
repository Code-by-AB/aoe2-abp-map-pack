<PLAYER_SETUP>

/* no-collision trade carts */
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_1 0
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_LINE_OF_SIGHT 4
/* effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_2 0 */ /* kept off like Tres Leches 2 - both radii zeroed causes issues */
 random_placement
 grouped_by_team  
/* ************************************ */
<LAND_GENERATION>

start_random
  percent_chance 20 #define FOREST_MAP
  percent_chance 20 #define ALPINE_MAP
  percent_chance 20 #define TROPICAL
  percent_chance 20 #define FALL
  percent_chance 20 #define SNOW
end_random

if FOREST_MAP
  base_terrain FOREST
elseif ALPINE_MAP
  base_terrain PINE_FOREST
elseif TROPICAL
  base_terrain JUNGLE
elseif FALL
  base_terrain DLC_FORESTAUTUMN
elseif SNOW
  base_terrain SNOW_FOREST
endif






if FOREST_MAP
create_player_lands
{
     terrain_type GRASS
     land_percent 100
     base_size 9
     border_fuzziness  15
     set_zone_by_team
