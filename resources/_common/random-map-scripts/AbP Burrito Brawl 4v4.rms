/* ************ Burrito Brawl 4v4 (AbP rework of Dragonmilk's original) ************ */
/* 7 Jan 21 */
/* Latest version: 7 Jan 22 */

/* Note: random_map.def is automatically included in every rms script */

/* ****************************************************** */
<PLAYER_SETUP>
 /* grouped_by_team */
 direct_placement
 
/* mods */
#const EXTRA_TCS 218
effect_amount MOD_RESOURCE EXTRA_TCS ATTR_ADD 7

effect_amount SET_ATTRIBUTE VILLAGER_BASE_F ATTR_HITPOINTS 9
effect_percent SET_ATTRIBUTE VILLAGER_BASE_F ATTR_MOVE_SPEED 110
effect_amount SET_ATTRIBUTE VILLAGER_BASE_M ATTR_HITPOINTS 9
effect_percent SET_ATTRIBUTE VILLAGER_BASE_M ATTR_MOVE_SPEED 110

effect_percent SET_ATTRIBUTE TRANSPORT_SHIP ATTR_MOVE_SPEED 80
effect_amount SET_ATTRIBUTE TRANSPORT_SHIP ATTR_RADIUS_1 0
effect_amount SET_ATTRIBUTE TRANSPORT_SHIP ATTR_LINE_OF_SIGHT 2

/* ****************************************************** */
<LAND_GENERATION>

base_terrain DLC_JUNGLEGRASS
enable_waves 0

/* One Burrito */
create_land 
{
 terrain_type DLC_FORESTAUTUMN
 land_percent 40
 left_border 33
 right_border 33
 if 2_PLAYER_GAME
	 top_border 19
	 bottom_border 19
 else
	 top_border 11
	 bottom_border 11
 endif
 border_fuzziness 69
 zone 5
}


/* corners */

create_land 
{
 terrain_type DLC_NEWSHALLOW
 land_percent 40
 left_border 2
 right_border 92
 top_border 2
 bottom_border 87
 border_fuzziness 69
 zone 6
}

create_land 
{
 terrain_type DLC_NEWSHALLOW
 land_percent 40
 left_border 92
 right_border 2
 top_border 2
 bottom_border 87
 border_fuzziness 69
 zone 6
}

create_land 
{
 terrain_type DLC_NEWSHALLOW
 land_percent 40
 left_border 2
 right_border 92
 top_border 87
 bottom_border 2
 border_fuzziness 69
 zone 6
}

create_land 
{
 terrain_type DLC_NEWSHALLOW
 land_percent 40
 left_border 92
 right_border 2
 top_border 87
 bottom_border 2
 border_fuzziness 69
 zone 6
}

/* fixed position player spawns, 4v4 rework v2 - full team sides, two plots per player on own side */
/* original 1v1 spawn concept courtesy Mike Hasselbach dude */

/* team 1 inner homes - left of the burrito */
create_land { land_position 26 15 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 26 38 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 26 61 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 26 84 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
/* team 2 inner homes - right of the burrito */
create_land { land_position 74 15 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 74 38 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 74 61 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 74 84 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
/* outer second homes - flags 1 resets assignment so each player gets a second plot, row-paired */
/* team 1 outer */
create_land { land_position 12 15 zone 1 assign_to AT_TEAM 1 -1 1 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 12 38 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 12 61 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 12 84 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
/* team 2 outer */
create_land { land_position 88 15 zone 2 assign_to AT_TEAM 2 -1 1 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 88 38 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 88 61 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 88 84 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
/* ****************************************************** */
<ELEVATION_GENERATION>

/* grassy stuff, a few hills and such */

/* Raise the Empanadas */

create_elevation 5
{
 base_terrain DLC_FORESTAUTUMN
 number_of_tiles 9000
 number_of_clumps 1
 set_scale_by_groups
	spacing 5
 enable_balanced_elevation
}

/* background */

create_elevation 7
{
 base_terrain DLC_JUNGLEGRASS
 number_of_tiles 2100
 number_of_clumps 69
 set_scale_by_groups
 enable_balanced_elevation
}


/* ****************************************************** */
/* <CLIFF_GENERATION> */

<TERRAIN_GENERATION>

/* 4 lakes */

create_terrain MED_WATER
{
 base_terrain DLC_NEWSHALLOW
 spacing_to_other_terrain_types 1
 land_percent 30
}
create_terrain MED_WATER
{
 base_terrain DLC_NEWSHALLOW
 spacing_to_other_terrain_types 1
 land_percent 30
}
create_terrain MED_WATER
{
 base_terrain DLC_NEWSHALLOW
 spacing_to_other_terrain_types 1
 land_percent 30
}
create_terrain MED_WATER
{
 base_terrain DLC_NEWSHALLOW
 spacing_to_other_terrain_types 1
 land_percent 30
}


/* Enchilada Fillings */

create_terrain DIRT
{
 base_terrain DLC_FORESTAUTUMN
 spacing_to_other_terrain_types 2
 land_percent 80
}

/* added ice to prevent full walling */

create_terrain ICE
{
 base_terrain DIRT
 land_percent 80
 spacing_to_other_terrain_types 8

}

/* the center */

create_terrain DLC_MANGROVESHALLOW
{
 base_terrain ICE
 spacing_to_other_terrain_types 2
 land_percent 80
}


/* rest of map */
create_terrain JUNGLE
{
 base_terrain DLC_JUNGLEGRASS
 number_of_clumps 21
 spacing_to_other_terrain_types 7
 land_percent 5
 set_avoid_player_start_areas
}

create_terrain DLC_RAINFOREST
{
 base_terrain DLC_JUNGLEGRASS
 number_of_clumps 13
 spacing_to_other_terrain_types 7
 land_percent 4
 set_avoid_player_start_areas
}

/* masking, Courtesy of Zetnus */
#const WATER_BROWN 96
create_terrain WATER_BROWN
{
    base_terrain DLC_MANGROVESHALLOW
    land_percent 100
    number_of_clumps 9320
    terrain_mask 1
}

<CONNECTION_GENERATION>

/* ****************************************************** */
<OBJECTS_GENERATION>

/* PLAYER STARTS */

create_object TOWN_CENTER
{
 set_place_for_every_player
 group_placement_radius 25
 min_distance_to_players 0
 max_distance_to_players 0
}

create_object VILLAGER
{
 set_place_for_every_player
 min_distance_to_players 3
 max_distance_to_players 6
 terrain_to_place_on DLC_JUNGLEGRASS
}

create_object SCOUT
{
 number_of_objects 1
 set_place_for_every_player
 min_distance_to_players 4
 max_distance_to_players 7
 terrain_to_place_on DLC_JUNGLEGRASS
}

#const smokey 902
create_object smokey
{
  number_of_objects             1

  set_place_for_every_player
  min_distance_to_players       1
  max_distance_to_players       1
  set_gaia_object_only
  set_gaia_unconvertible
  temp_min_distance_group_placement  3
}

