/* ************ Burrito Brawl 4v4 (AbP rework of Dragonmilk's original) ************ */
/* AbP 2026-09: the centre is desert with resources (no sailable water between the teams) and fish are kept under the DE AI's water-map threshold, so the AI plays it as a land map. Corner ponds stay dockable. */
/* 7 Jan 21 */
/* Latest version: 7 Jan 22 */

/* Note: random_map.def is automatically included in every rms script */

/* ****************************************************** */
<PLAYER_SETUP>
 /* grouped_by_team */
 direct_placement
 
/* mods */
#const EXTRA_TCS 218
effect_amount MOD_RESOURCE EXTRA_TCS ATTR_ADD 7

effect_amount SET_ATTRIBUTE VILLAGER_BASE_F ATTR_HITPOINTS 9
effect_percent SET_ATTRIBUTE VILLAGER_BASE_F ATTR_MOVE_SPEED 110
effect_amount SET_ATTRIBUTE VILLAGER_BASE_M ATTR_HITPOINTS 9
effect_percent SET_ATTRIBUTE VILLAGER_BASE_M ATTR_MOVE_SPEED 110

effect_percent SET_ATTRIBUTE TRANSPORT_SHIP ATTR_MOVE_SPEED 80
effect_amount SET_ATTRIBUTE TRANSPORT_SHIP ATTR_RADIUS_1 0
effect_amount SET_ATTRIBUTE TRANSPORT_SHIP ATTR_LINE_OF_SIGHT 2

/* no-collision trade carts (Tres Leches 2 proven config) */
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_1 0
effect_amount SET_ATTRIBUTE TRADE_CART ATTR_LINE_OF_SIGHT 4
/* effect_amount SET_ATTRIBUTE TRADE_CART ATTR_RADIUS_2 0 */ /* kept off - both radii zeroed = carts walk on water */

/* ****************************************************** */
<LAND_GENERATION>

base_terrain DLC_JUNGLEGRASS
enable_waves 0

/* One Burrito */
create_land 
{
 terrain_type DLC_FORESTAUTUMN
 land_percent 40
 left_border 33
 right_border 33
 if 2_PLAYER_GAME
	 top_border 19
	 bottom_border 19
 else
	 top_border 11
	 bottom_border 11
 endif
 border_fuzziness 69
 zone 5
}


/* corners */

create_land 
{
 terrain_type DLC_NEWSHALLOW
 land_percent 40
 left_border 2
 right_border 92
 top_border 2
 bottom_border 87
 border_fuzziness 69
 zone 6
}

create_land 
{
 terrain_type DLC_NEWSHALLOW
 land_percent 40
 left_border 92
 right_border 2
 top_border 2
 bottom_border 87
 border_fuzziness 69
 zone 6
}

create_land 
{
 terrain_type DLC_NEWSHALLOW
 land_percent 40
 left_border 2
 right_border 92
 top_border 87
 bottom_border 2
 border_fuzziness 69
 zone 6
}

create_land 
{
 terrain_type DLC_NEWSHALLOW
 land_percent 40
 left_border 92
 right_border 2
 top_border 87
 bottom_border 2
 border_fuzziness 69
 zone 6
}

/* fixed position player spawns, 4v4 rework v4 - team-side placement via assign_to AT_TEAM, two plots each */
/* Team 1 fills the left of the burrito top-to-bottom in lobby order, team 2 the right. */
/* Each player keeps an inner home + an outer second home: the inner land is assigned with */
/* flags 2 ("do not remember this assignment") so its paired outer land resolves to the same */
/* player, then flags 0 records them and the next pair advances to the next team member. */
/* REQUIRES two real teams of 2+ players - AoE2 does not count a 1-player team as a team, */
/* so this map cannot generate a 1v1 or an FFA (same rule as the Trio maps). */
/* original 1v1 spawn concept courtesy Mike Hasselbach dude */

/* team 1 - left of the burrito: inner home, then outer second home, per player */
create_land { land_position 26 15 zone 1 assign_to AT_TEAM 1 -1 2 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 12 15 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 26 38 zone 1 assign_to AT_TEAM 1 -1 2 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 12 38 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 26 61 zone 1 assign_to AT_TEAM 1 -1 2 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 12 61 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 26 84 zone 1 assign_to AT_TEAM 1 -1 2 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 12 84 zone 1 assign_to AT_TEAM 1 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
/* team 2 - right of the burrito: inner home, then outer second home, per player */
create_land { land_position 74 15 zone 2 assign_to AT_TEAM 2 -1 2 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 88 15 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 74 38 zone 2 assign_to AT_TEAM 2 -1 2 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 88 38 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 74 61 zone 2 assign_to AT_TEAM 2 -1 2 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 88 61 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 74 84 zone 2 assign_to AT_TEAM 2 -1 2 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
create_land { land_position 88 84 zone 2 assign_to AT_TEAM 2 -1 0 terrain_type DLC_JUNGLEGRASS base_size 3 land_percent 0 other_zone_avoidance_distance 1 border_fuzziness 99 }
/* ****************************************************** */
<ELEVATION_GENERATION>

/* grassy stuff, a few hills and such */

/* Raise the Empanadas */

create_elevation 5
{
 base_terrain DLC_FORESTAUTUMN
 number_of_tiles 9000
 number_of_clumps 1
 set_scale_by_groups
	spacing 5
 enable_balanced_elevation
}

/* background */

create_elevation 7
{
 base_terrain DLC_JUNGLEGRASS
 number_of_tiles 2100
 number_of_clumps 69
 set_scale_by_groups
 enable_balanced_elevation
}


/* ****************************************************** */
/* <CLIFF_GENERATION> */

<TERRAIN_GENERATION>

/* 4 lakes - dockable corner ponds (AbP: kept deep on purpose; the sailable route between the teams was the mangrove middle, now land) */
create_terrain MED_WATER
{
 base_terrain DLC_NEWSHALLOW
 spacing_to_other_terrain_types 1
 land_percent 30
}
create_terrain MED_WATER
{
 base_terrain DLC_NEWSHALLOW
 spacing_to_other_terrain_types 1
 land_percent 30
}
create_terrain MED_WATER
{
 base_terrain DLC_NEWSHALLOW
 spacing_to_other_terrain_types 1
 land_percent 30
}
create_terrain MED_WATER
{
 base_terrain DLC_NEWSHALLOW
 spacing_to_other_terrain_types 1
 land_percent 30
}
/* Enchilada Fillings */

create_terrain DIRT
{
 base_terrain DLC_FORESTAUTUMN
 spacing_to_other_terrain_types 5
 land_percent 80
}

/* added ice to prevent full walling */

create_terrain ICE
{
 base_terrain DIRT
 land_percent 80
 spacing_to_other_terrain_types 8

}

/* AbP: the centre is land now - desert with gold, stone, ostrich, elephants and jungle clumps for wood. */
/* The old mangrove core was dockable, and any dock on this map puts every AI into its naval/legacy mode. */
create_terrain DESERT
{
 base_terrain ICE
 spacing_to_other_terrain_types 2
 land_percent 80
}
create_terrain JUNGLE
{
 base_terrain DESERT
 number_of_clumps 14
 spacing_to_other_terrain_types 3
 land_percent 14
 set_scale_by_groups
}
/* rest of map */
create_terrain JUNGLE
{
 base_terrain DLC_JUNGLEGRASS
 number_of_clumps 34
 spacing_to_other_terrain_types 7
 land_percent 10
 set_avoid_player_start_areas
}

create_terrain DLC_RAINFOREST
{
 base_terrain DLC_JUNGLEGRASS
 number_of_clumps 21
 spacing_to_other_terrain_types 7
 land_percent 8
 set_avoid_player_start_areas
}

