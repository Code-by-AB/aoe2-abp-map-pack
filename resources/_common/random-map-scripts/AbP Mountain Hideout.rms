<ELEVATION_GENERATION>
create_elevation 7
{
	base_terrain SNOW_FOREST
	if DE_AVAILABLE
		number_of_tiles 100000
	else
		number_of_tiles 10000
	endif
	number_of_clumps 1000
	set_scale_by_groups
	spacing 3
}
	
<TERRAIN_GENERATION>
create_terrain GRASS_SNOW
