<TERRAIN_GENERATION>

create_terrain FOREST
{
	base_terrain                   GRASS3
	spacing_to_other_terrain_types 0
	land_percent                   100
	number_of_clumps               70
	set_avoid_player_start_areas     30
	set_scale_by_groups
	clumping_factor                1
	height_limits 0 4                      
}

